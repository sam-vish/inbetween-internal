{
  "name": "inbetween",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time AI clipping for YouTube Live streamers",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "worker": "pnpm --filter @inbetween/worker start",
    "worker:dev": "pnpm --filter @inbetween/worker dev",
    "dashboard": "pnpm --filter @inbetween/dashboard dev",
    "premium:worker": "pnpm --filter @inbetween/premium worker",
    "replay": "tsx scripts/replay.ts",
    "synthetic": "tsx scripts/make-synthetic.ts",
    "e2e": "tsx scripts/e2e.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @inbetween/dashboard typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@inbetween/adapters": "workspace:*",
    "@inbetween/providers": "workspace:*",
    "@inbetween/render": "workspace:*",
    "@inbetween/shared": "workspace:*",
    "@inbetween/worker": "workspace:*"
  }
}
