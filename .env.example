# ---------------------------------------------------------------------------
# Inbetween — environment. Copy to .env and fill in. Every integration is
# optional: without keys the worker runs offline (memory DB, local storage,
# mock ASR/vision/LLM), which is what scripts/replay.ts --memory and the e2e use.
# ---------------------------------------------------------------------------

# --- worker process ---
LOG_LEVEL=info
WORKER_HOST_ID=vps-1                # names this box's render queue (render@<host>)
DATA_DIR=./data                     # rolling buffers, source clips, render scratch
WORKER_HTTP_PORT=8787               # /healthz, /metrics, /files (dev), /websub
WORKER_ROLE=all                     # all | ingest | render
RENDER_CONCURRENCY=2
MAX_STREAMS=6                       # per box; ~5 streams per 8 vCPU / 16 GB (measure in M1)
PUBLIC_WORKER_URL=                  # https URL of this worker, for WebSub pings (optional)
WEBSUB_ENABLED=false
X264_PRESET=veryfast

# --- YouTube ---
YOUTUBE_API_KEY=                    # Data API v3 key (videos.list + liveChatMessages.streamList)
YOUTUBE_DAILY_QUOTA=10000           # per-project allocation; resets midnight PT (~13:30 IST)
GO_LIVE_INTERVAL_S=60               # no-quota /live page probe per client
STREAMS_TAB_INTERVAL_S=300          # multi-broadcast check while live
HLS_RESOLVER=streamlink             # streamlink | ytdlp
HLS_QUALITY=720p60,720p,best
CHAT_POLL_MIN_MS=8000               # floor for the list-polling fallback (5 units/poll)
YOUTUBE_COOKIES_FILE=               # Netscape cookies.txt if YouTube bot-walls the VPS IP

# --- Google OAuth (client consent, youtube.readonly) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback
OAUTH_ENCRYPTION_KEY=               # 32-byte hex/base64; encrypts refresh tokens at rest (openssl rand -hex 32)
OAUTH_LINK_SECRET=                  # signs consent links + OAuth state (openssl rand -hex 32)
AUTHOR_HASH_SALT=                   # salts viewer author hashes (openssl rand -hex 16)

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=               # service role: worker + OAuth callback only, never the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_URL=http://localhost:3000       # dashboard origin, used in consent links

# --- Redis (bus + queues). Unset = single-process in-memory mode ---
REDIS_URL=redis://localhost:6379

# --- Cloudflare R2 (clips, thumbnails, source clips). Unset = ./data/storage ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=                 # optional custom domain; otherwise presigned URLs
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8787/files   # dev: worker serves local storage

# --- Providers (pluggable; see packages/providers) ---
ASR_PROVIDER=                       # groq | deepgram | sarvam | mock | none (default: first key present)
ASR_LIVE_PROVIDER=                  # live voice_hype ASR (defaults to ASR_PROVIDER)
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
VISION_PROVIDER=                    # gemini | mock | none
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=                       # claude | mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
PRICING_OVERRIDES_JSON=             # e.g. {"groq:whisper-large-v3-turbo":{"perAudioHour":0.04,"minBilledS":10}}

# --- Delivery + ops alerts ---
TELEGRAM_BOT_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=        # path or inline JSON; share client Drive folders with it
DISCORD_MAX_UPLOAD_MB=10
TELEGRAM_MAX_UPLOAD_MB=50
OPS_DISCORD_WEBHOOK_URL=            # operator alerts (quota 70/90/100%, cost caps, failures)
OPS_TELEGRAM_CHAT_ID=

# --- Premium lane ---
CLAUDE_CODE_BIN=claude
PREMIUM_CONCURRENCY=1
PREMIUM_CLAUDE_ARGS=                # extra args for headless Claude Code, space separated
